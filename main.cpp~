#include <iostream>
#include <cstring>
#include <cctype>
using namespace std;

int main() {
  char str[80];
  char str2[80];
  cin.get(str, 80);
  cin.get(); 
  int count = 0;
  for (int i = 0; str[i] != '\0'; i++) {
    if (std::isalpha(str[i])) {
      str2[count] = str[i];
      count += 1;
    }
  }
  str2[count] = '\0';
  char str3[count + 1];
  for (int i = 0; i < count; i++) {
    str3[i] = str2[count-1-i];
  }
  str3[count] = '\0';
  cout << str3 << endl;
  return 0;
}
